---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Projects', href: '/projects' },
  { label: 'Blog', href: '/blog' },
  { label: 'Contact', href: '/contact' },
];
---

<header class="border-b border-[#efe2cc] bg-[#fffaf2]/95 backdrop-blur">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-5 lg:px-8">
    <a href="/" class="flex items-center gap-3">
      <div class="flex h-10 w-10 items-center justify-center rounded-full bg-[#5a1f14] text-sm font-semibold uppercase tracking-[0.3em] text-[#f7efe8]">GT</div>
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.35em] text-[#9f6a3c]">George's Tech</p>
        <p class="text-base font-semibold text-[#23110d]">Innovations</p>
      </div>
    </a>
    <nav class="hidden items-center gap-6 text-sm font-medium text-[#5a1f14] md:flex">
      {navItems.map((item) => (
        <a href={item.href} class="transition hover:text-[#a74b2f]">{item.label}</a>
      ))}
    </nav>
    <a href="/contact" class="hidden rounded-full border border-[#9f6a3c] px-4 py-2 text-sm font-semibold text-[#5a1f14] transition hover:bg-[#f3e3cc] md:inline-flex">Book a call</a>
  </div>
</header>
