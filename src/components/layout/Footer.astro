---
const currentYear = new Date().getFullYear();
---

<footer class="border-t border-[#efe2cc] bg-[#fffaf2]">
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-6 py-10 lg:flex-row lg:items-center lg:justify-between lg:px-8">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.35em] text-[#9f6a3c]">The George's Tech Innovations</p>
      <p class="mt-2 max-w-xl text-sm leading-7 text-[#6b5b50]">Placeholder company copy for a modern technology studio focused on product strategy, digital experiences, and resilient innovation.</p>
    </div>
    <div class="flex flex-wrap gap-4 text-sm text-[#5a1f14]">
      <a href="/about" class="transition hover:text-[#a74b2f]">About</a>
      <a href="/services" class="transition hover:text-[#a74b2f]">Services</a>
      <a href="/blog" class="transition hover:text-[#a74b2f]">Blog</a>
      <a href="/contact" class="transition hover:text-[#a74b2f]">Contact</a>
    </div>
  </div>
  <div class="border-t border-[#efe2cc] px-6 py-4 text-center text-sm text-[#6b5b50] lg:px-8">
    © {currentYear} The George's Tech Innovations. All rights reserved.
  </div>
</footer>
