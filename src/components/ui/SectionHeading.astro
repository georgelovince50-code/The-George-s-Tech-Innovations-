---
const { eyebrow, title, description } = Astro.props;
---

<div class="max-w-2xl space-y-4">
  {eyebrow && <p class="text-sm font-semibold uppercase tracking-[0.3em] text-[#9f6a3c]">{eyebrow}</p>}
  <h2 class="text-3xl font-bold text-[#23110d] sm:text-4xl">{title}</h2>
  {description && <p class="text-lg leading-8 text-[#6b5b50]">{description}</p>}
</div>
